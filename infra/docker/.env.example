# =============================================================================
# Bonakala Platform - internal pilot - environment template
# Copy to .env and fill in. In real deployments generate this file from SOPS
# (infra/docker/secrets/*.enc.env) at deploy time; never commit a filled .env.
# REFERENCE SKELETON - complete during the build.
# =============================================================================

# --- Release ---------------------------------------------------------------
REGISTRY=registry.example.internal
BONAKALA_VERSION=0.1.0                 # pin to a signed release tag (cosign verified)

# --- Hostnames / TLS -------------------------------------------------------
PLATFORM_HOST=platform.practice.example.co.za
ACME_EMAIL=ops@example.co.za           # leave blank to use the internal CA (see caddy/Caddyfile)

# --- Postgres 16 (+ pgvector, pg_partman) ----------------------------------
POSTGRES_DB=bonakala
POSTGRES_USER=bonakala
POSTGRES_PASSWORD=change-me-long-random
PG_SHARED_BUFFERS=8GB                  # ~25 % of RAM on the pilot node

# --- Object store (MinIO or SeaweedFS S3 gateway) --------------------------
MINIO_ROOT_USER=bonakala-admin
MINIO_ROOT_PASSWORD=change-me-long-random

# --- Off-site immutable copy (second SA data centre) -----------------------
OFFSITE_S3_ENDPOINT=https://s3.offsite.example.co.za
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=

# --- Search -----------------------------------------------------------------
MEILI_MASTER_KEY=change-me-32-chars-minimum

# --- Orthanc central archive ----------------------------------------------
ORTHANC_USER=bonakala
ORTHANC_PASSWORD=change-me-long-random

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-long-random
OIDC_CLIENT_ID=bonakala-web
OIDC_CLIENT_SECRET=                    # for confidential clients (api, grafana)

# --- Application secrets ---------------------------------------------------
SESSION_SIGNING_KEY=change-me-64-hex
ENCRYPTION_KEY_ID=practice-a-2026      # KMS / Vault key reference for document encryption

# --- LLM egress gateway (only path to the Claude API; de-identification on) --
LLM_GATEWAY_URL=http://llm-gateway:8080
ANTHROPIC_API_KEY=                     # held by the gateway, not by api/agents
HAND_DAILY_BUDGET_ZAR=2000             # illustrative leash; per tenant per day

# --- WhatsApp Business Cloud API ------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# --- Messaging (SA SMS aggregator, transactional email) -------------------
SMS_API_URL=
SMS_API_KEY=
SMTP_URL=

# --- Claims switch and PSP adapters (see docs/14) --------------------------
SWITCH_ADAPTER=none                    # none | <switch-adapter-name>
SWITCH_ENDPOINT=
SWITCH_CLIENT_CERT_PATH=
PSP_ADAPTER=none
PSP_MERCHANT_ID=
PSP_API_KEY=

# --- Observability ---------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me
OTEL_SAMPLING_RATIO=1.0

# --- Locale -----------------------------------------------------------------
TZ=Africa/Johannesburg
DEFAULT_LOCALE=en-ZA
