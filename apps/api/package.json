{
  "name": "@bonakala/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "dev:worker": "wrangler dev --config ../../infra/cloudflare/wrangler.toml",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@bonakala/db": "workspace:*",
    "@bonakala/domain": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@anthropic-ai/sdk": "^0.126.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.132.0"
  }
}
