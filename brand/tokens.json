{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Bonakala Design Language \u2014 Latent Image",
  "version": "1.0.0",
  "licence": "Proprietary (Bonakala). Fonts referenced are SIL OFL 1.1.",
  "color": {
    "bone": {
      "value": "#F5F1E9",
      "role": "light surface"
    },
    "bone-2": {
      "value": "#EAE4D8",
      "role": "light surface elevated / dividers"
    },
    "carbon": {
      "value": "#0E1113",
      "role": "dark surface"
    },
    "graphite": {
      "value": "#171B1E",
      "role": "dark elevated surface"
    },
    "ink": {
      "value": "#1B1F22",
      "role": "text on light"
    },
    "marrow": {
      "value": "#14324A",
      "role": "brand deep blue on light"
    },
    "signal": {
      "value": "#12B5A5",
      "role": "primary on dark; success"
    },
    "signal-ink": {
      "value": "#0A7268",
      "role": "primary / links on light (AA on bone)"
    },
    "beam": {
      "value": "#F0A52B",
      "role": "warning / attention"
    },
    "beam-ink": {
      "value": "#8A5A00",
      "role": "warning text on light"
    },
    "flare": {
      "value": "#E5484D",
      "role": "critical / error / STAT"
    },
    "flare-ink": {
      "value": "#B3262B",
      "role": "critical text on light"
    },
    "iris": {
      "value": "#5B8FE8",
      "role": "informational; links on dark"
    },
    "ash": {
      "050": {
        "value": "#FAF8F4"
      },
      "100": {
        "value": "#F0ECE4"
      },
      "200": {
        "value": "#E2DCD1"
      },
      "300": {
        "value": "#CFC8BB"
      },
      "400": {
        "value": "#B3AC9F"
      },
      "500": {
        "value": "#8E887C"
      },
      "600": {
        "value": "#6B665C"
      },
      "700": {
        "value": "#4F4B44"
      },
      "800": {
        "value": "#36332E"
      },
      "900": {
        "value": "#24221F"
      },
      "950": {
        "value": "#151412"
      }
    },
    "iris-ink": {
      "value": "#2A5FC0",
      "role": "informational text / links on light"
    }
  },
  "contrast-verified-pairs": [
    {
      "fg": "ink",
      "bg": "bone",
      "ratio": 14.73,
      "use": "body text on light"
    },
    {
      "fg": "marrow",
      "bg": "bone",
      "ratio": 11.76,
      "use": "headings on light"
    },
    {
      "fg": "signal-ink",
      "bg": "bone",
      "ratio": 5.15,
      "use": "links, primary button surface on light"
    },
    {
      "fg": "bone",
      "bg": "signal-ink",
      "ratio": 5.15,
      "use": "primary button label on light lens"
    },
    {
      "fg": "bone",
      "bg": "carbon",
      "ratio": 16.82,
      "use": "body text on dark"
    },
    {
      "fg": "signal",
      "bg": "carbon",
      "ratio": 7.38,
      "use": "primary on dark"
    },
    {
      "fg": "carbon",
      "bg": "signal",
      "ratio": 7.38,
      "use": "primary button label on dark lens"
    },
    {
      "fg": "beam",
      "bg": "carbon",
      "ratio": 9.13,
      "use": "warning on dark"
    },
    {
      "fg": "flare",
      "bg": "carbon",
      "ratio": 4.84,
      "use": "critical on dark"
    },
    {
      "fg": "flare-ink",
      "bg": "bone",
      "ratio": 5.77,
      "use": "critical text on light"
    },
    {
      "fg": "beam-ink",
      "bg": "bone",
      "ratio": 5.26,
      "use": "warning text on light"
    },
    {
      "fg": "iris",
      "bg": "carbon",
      "ratio": 5.9,
      "use": "info on dark"
    },
    {
      "fg": "iris-ink",
      "bg": "bone",
      "ratio": 5.33,
      "use": "info on light"
    },
    {
      "fg": "ash.600",
      "bg": "bone",
      "ratio": 5.07,
      "use": "secondary text on light"
    },
    {
      "fg": "ash.400",
      "bg": "carbon",
      "ratio": 8.41,
      "use": "secondary text on dark"
    }
  ],
  "font": {
    "display": {
      "family": "Manrope",
      "licence": "SIL OFL 1.1",
      "weights": [
        600,
        700
      ]
    },
    "text": {
      "family": "Inter",
      "licence": "SIL OFL 1.1",
      "weights": [
        400,
        500,
        600
      ]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "licence": "SIL OFL 1.1",
      "weights": [
        400,
        500
      ]
    },
    "fallback": {
      "family": "Noto Sans",
      "licence": "SIL OFL 1.1"
    },
    "scale-px": [
      12,
      13,
      14,
      16,
      18,
      22,
      28,
      36,
      48,
      64
    ],
    "line-height": {
      "body": 1.45,
      "display": 1.15
    },
    "numerals": "tabular"
  },
  "space": {
    "unit": 4,
    "scale": [
      2,
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ]
  },
  "radius": {
    "input": 9,
    "card": 14,
    "sheet": 22,
    "pill": 9999
  },
  "glass": {
    "blur-px": 10,
    "saturate-pct": 120,
    "note": "Kept subtle: applied only to floating chrome (nav rail, topbar, cards, tiles, sheets, toasts), with surfaces mostly opaque (72-80% fill) and a restrained blur/tint. Data tables, form inputs and the image viewer stay fully opaque (surface-solid tokens) so dense clinical and financial content never loses legibility to a blur effect."
  },
  "motion": {
    "develop-ms": 180,
    "develop-rise-px": 2,
    "stagger-ms": 40,
    "reduced": "respect prefers-reduced-motion"
  },
  "lens": {
    "patient": {
      "surface": "bone",
      "level": "L1",
      "window": "W1",
      "accent": "signal-ink"
    },
    "referrer": {
      "surface": "bone",
      "level": "L2",
      "window": "W2",
      "accent": "marrow"
    },
    "clinical": {
      "surface": "carbon",
      "level": "L3",
      "window": "W3",
      "accent": "signal"
    },
    "business": {
      "surface": "bone",
      "level": "L3",
      "window": "W2",
      "accent": "marrow"
    },
    "governance": {
      "surface": "bone",
      "level": "L2",
      "window": "W2",
      "accent": "marrow"
    }
  },
  "level": {
    "L1": {
      "space-unit": 8,
      "row-height": 56,
      "type-px": 16
    },
    "L2": {
      "space-unit": 6,
      "row-height": 48,
      "type-px": 15
    },
    "L3": {
      "space-unit": 4,
      "row-height": 40,
      "type-px": 14
    },
    "L4": {
      "space-unit": 3,
      "row-height": 32,
      "type-px": 13
    }
  },
  "window": {
    "W1": {
      "border": "hairline-soft",
      "shadow": "none",
      "chip-saturation": 0.7,
      "secondary-fields": 2
    },
    "W2": {
      "border": "hairline",
      "shadow": "tint-1",
      "chip-saturation": 0.85,
      "secondary-fields": 4
    },
    "W3": {
      "border": "solid",
      "shadow": "none",
      "chip-saturation": 1.0,
      "secondary-fields": 8
    }
  },
  "status": {
    "neutral": {
      "color": "ash.500",
      "icon": "circle"
    },
    "active": {
      "color": "iris",
      "icon": "half-circle"
    },
    "done": {
      "color": "signal",
      "icon": "check-circle"
    },
    "attention": {
      "color": "beam",
      "icon": "triangle"
    },
    "critical": {
      "color": "flare",
      "icon": "octagon"
    },
    "ai": {
      "color": "ash.700",
      "border": "dashed",
      "icon": "sparkle-square",
      "label-font": "mono"
    }
  }
}