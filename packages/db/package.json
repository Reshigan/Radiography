{
  "name": "@bonakala/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./node": "./src/node.ts",
    "./d1": "./src/d1.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
